# ═══════════════════════════════════════════════════════════════════
# DevFlow 环境变量示例
#
# 使用方法：
#   1) 复制本文件为 .env：    cp .env.example .env
#   2) 把下列 sk-xxx 替换成真实密钥（DeepSeek / SiliconFlow / 自建 OpenAI 兼容）
#   3) 不需要的提供商可以从 LLM_PROVIDERS_JSON 中删掉
# ═══════════════════════════════════════════════════════════════════

# ── LLM：推荐用 LLM_PROVIDERS_JSON 配置多提供商（推荐）───────────────
# 字段：name / base_url / api_key / model / temperature(可选, 默认 0.1)
#       headers(可选)：附加请求头（透传 ChatOpenAI default_headers）。
#         OpenCode Go 网关要求 x-opencode-session（每会话稳定 ID）+ User-Agent 自报客户端名
#       models(可选)：同供应商模型池，展开为顺序 fallback 链
#       （激活模型 = model，打头沿用 name；其余依次跟随，命名 name:模型名），
#       配合 LLM_ACTIVE_MODEL 可不改 JSON 直接切换激活模型（见下方说明）
#       context_window(可选)：上下文窗口 tokens。int 作用于该供应商全部模型；
#         dict 按模型名单独指定（如 {"deepseek-v4-pro": 200000}）。
#         未配置时按模型名自动匹配官方规格（GLM-5.3 / Qwen3.8-Max / Kimi K3 = 1M，
#         DeepSeek V4 = 200K，deepseek-chat/flash = 128K 等）；未收录的自定义模型 ≥128k。
#
# 兼容的 OpenAI 格式服务（无需额外安装 langchain-deepseek 等包）：
#   DeepSeek:    base_url=https://api.deepseek.com/v1
#   OpenCode Go: base_url=https://opencode.ai/zen/go/v1（订阅制聚合网关，见下）
#   SiliconFlow: base_url=https://api.siliconflow.cn/v1
#   自建 vLLM:   base_url=http://your-vllm-host:8000/v1
#   OneAPI:      base_url=http://your-oneapi-host/v1
#   Ollama(开web): base_url=http://localhost:11434/v1  api_key=ollama
#
# OpenCode Go 套餐（https://opencode.ai/go）：
#   $10/月（首月 $5），额度：5 小时 $12 / 每周 $30 / 每月 $60 的模型用量
#   一个订阅聚合多家开源编程模型（GLM / Qwen / DeepSeek / Kimi / MiniMax 等），
#   OpenAI 兼容接口；到 https://opencode.ai/auth 订阅后复制 API Key 即可
#   完整模型列表：curl https://opencode.ai/zen/go/v1/models

LLM_PROVIDERS_JSON='[
  {
    "name": "deepseek",
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "sk-your-deepseek-key",
    "model": "deepseek-flash",
    "temperature": 0.1
  },
  {
    "name": "opencode-go",
    "base_url": "https://opencode.ai/zen/go/v1",
    "api_key": "sk-your-opencode-go-key",
    "headers": {"x-opencode-session": "devflow-cli", "User-Agent": "devflow/1.0"},
    "model": "deepseek-v4-flash",
    "models": [
      "deepseek-v4-flash",
      "deepseek-v4-pro",
      "glm-5.3",
      "qwen3.8-max",
      "kimi-k3"
    ],
    "temperature": 0.1
  },
  {
    "name": "siliconflow",
    "base_url": "https://api.siliconflow.cn/v1",
    "api_key": "sk-your-siliconflow-key",
    "model": "deepseek-ai/DeepSeek-V4-Flash",
    "temperature": 0.1
  }
]'

# ── LLM_ACTIVE_MODEL：同供应商多模型切换（不改 LLM_PROVIDERS_JSON）──
# 值为模型名时，模型池里含该模型的所有 provider 都切换激活模型：
#   LLM_ACTIVE_MODEL=deepseek-v4-pro
# 也可用「provider名/模型名」限定只切换某一个供应商：
#   LLM_ACTIVE_MODEL=opencode-go/deepseek-v4-pro
# 留空 = 各 provider 用自己的 "model" 字段；模型不在任何池里时无效果
LLM_ACTIVE_MODEL=

# ── LLM_USE_MOCK_FALLBACK：真实提供商全部失败时，是否启用 Mock 兜底 ──
# 开发/演示时推荐 = 1（永远不会卡死无输出）
# 生产环境可设 = 0（必须真实 LLM 出结果，否则报错）
LLM_USE_MOCK_FALLBACK=1

# ═══════════════════════════════════════════════════════════════════
# 兼容旧版：不写 LLM_PROVIDERS_JSON 时，以下字段生效（单提供商+mock）
# ═══════════════════════════════════════════════════════════════════

# 默认：DeepSeek（OpenAI 兼容接口，无需额外 langchain-deepseek 包）
# 可选模型：deepseek-flash（便宜）/ deepseek-v4-pro（更强）
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1

# 旧版 fallback 链（逗号分隔），mock 会自动作为最终兜底
# 不写 LLM_PROVIDERS_JSON 时：primary(deepseek) + LLM_FALLBACKS 列表
LLM_FALLBACKS=mock

# ── SPEC 5.5 Token 预算（日）───────────────────────────────────
# 0 = 不限，生产建议设 500000 ~ 5000000 防止刷爆
LLM_TOKEN_BUDGET_DAILY=0

# 全局 context window 兜底（仅未收录的自定义模型使用，且不低于 128k）；
# 已知模型自动按官方规格（GLM-5.3/Qwen3.8-Max/Kimi K3 = 1M、DeepSeek V4 = 200K…），
# 单个供应商可用 LLM_PROVIDERS_JSON 的 context_window 字段覆盖
LLM_CONTEXT_WINDOW_TOKENS=128000

# ── Checkpoint SQLite ──────────────────────────────────────────
# 断点恢复用，放在工作目录 data/checkpoints.db 即可
CHECKPOINT_SQLITE_PATH=./data/checkpoints.db

# ── OpenCode（阶段二/三）───────────────────────────────────────
# 本地部署的 OpenCode Server；不配置 → 自动 Mock
OPENCODE_BASE_URL=http://localhost:8080
OPENCODE_API_TOKEN=

# ── OpenCode CLI（测试设计技能执行器，opencode run 子进程）────
# 安装：npm install -g opencode-ai；选用方式：TEST_GEN_PROVIDER=opencode
OPENCODE_BIN=opencode
# 技能派发使用的 agent 名（目标项目 opencode 配置里需存在该 agent）
OPENCODE_AGENT=test-designer
# opencode run 单次调用超时（秒）与附加 CLI 参数（空格分隔，如 --auto）
OPENCODE_RUN_TIMEOUT_SEC=900
OPENCODE_EXTRA_ARGS=

# ── 测试设计 feature 化（可选流程，默认单次整单）──────────────
# single（默认）= 一次性整单设计；feature = 拆分 → 逐 feature 生成 → 单元评审 → 合并
TEST_DESIGN_MODE=single
TEST_DESIGN_MAX_FEATURES=8
TEST_DESIGN_CONCURRENCY=3
TEST_DESIGN_REVIEW_ROUNDS=2
# 技能执行器（可选）：开启后逐 feature 派发时把下方目录的 SKILL.md 绝对路径
# 显式传给执行器（prompt 前缀要求先完整读取并严格遵守）
TEST_DESIGN_USE_SKILLS=0
TEST_DESIGN_SKILL_DIR=

# ═══════════════════════════════════════════════════════════════════
# CodeProvider 后端选择（阶段二/三）
#
# 各能力可独立选择后端：
#   CODE_SEARCH_PROVIDER      codegraph(语义检索) | opencode | mock(默认)
#   CODE_GRAPH_RENDER_PROVIDER archify(HTML/SVG)  | mermaid(默认,纯文本) | mock
#   CODE_EDIT_PROVIDER        opencode | mock(默认)
#   TEST_GEN_PROVIDER         opencode | mock(默认)
#
# 用 `devflow check-providers` 一键自检所有后端的可用性。
# ═══════════════════════════════════════════════════════════════════
CODE_SEARCH_PROVIDER=mock
CODE_GRAPH_RENDER_PROVIDER=mermaid
CODE_EDIT_PROVIDER=mock
TEST_GEN_PROVIDER=mock

# ── CodeGraph（语义代码检索）────────────────────────────────────
# 二进制：官方安装脚本
#   curl -fsSL https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh | sh
# 索引：在项目根目录执行 `codegraph init` 生成 .codegraph/
CODEGRAPH_REQUIRE_INDEX=0
#   0（默认）= 索引缺失仅告警，搜索自动回退 Mock（开发期友好）
#   1         = 索引缺失视为硬错误（生产环境强制要求先 init）

# ── Archify（架构图渲染，需 node + npx）─────────────────────────
# 依赖：node >= 18 + npx；不满足时自动回退 Mermaid 文本
# ARCHIFY_FORCE_MERMAID_FALLBACK=1   # 强制走 Mermaid，跳过 npx 渲染

# ── 记忆策略 ──────────────────────────────────────────────────
# 澄清节点保留最近 N 轮对话（防止上下文爆炸）
HOT_MEMORY_LAST_N=5

# ── 需求澄清轮次 ──────────────────────────────────────────────
# 普通澄清（一次列出所有缺失项）轮次上限，超限仍有缺失 → 终止并记死信
CLARIFY_MAX_ROUNDS=6
# 对话式澄清（「头脑风暴」/「拷问」模式，一轮只问一个问题）轮次上限
CLARIFY_DIALOG_MAX_ROUNDS=12

# ── 执行闭环（diff 落盘 + 真实测试执行）─────────────────────────
# code_gen 产出的 unified diff 是否真正写入目标项目（all-or-nothing + 自动备份到
# 目标项目 .devflow_backup/，可回滚）。关闭后流程退化为「仅测试场景设计」模式。
APPLY_CODE_ENABLED=1
# 落盘后是否在目标项目里真实跑 pytest（junit-xml 解析，失败自动回 code_gen 修复）
TEST_RUN_ENABLED=1
# 单轮 pytest 超时（秒）；超时按「未执行」处理，不误判为测试失败
TEST_RUN_TIMEOUT_SEC=300
# 测试连续失败时自动回 code_gen 修复的最大轮数；超限后带失败报告进人工验收
TEST_RUN_MAX_FIX_ROUNDS=2
# 限定 pytest 收集范围（逗号分隔相对路径，如 tests/）；留空 = 整个项目
TEST_RUN_PATHS=
